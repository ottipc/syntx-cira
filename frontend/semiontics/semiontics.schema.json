{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cira.semiontics.yaml",
  "type": "object",
  "required": ["version", "tokens", "signified_enums", "labelled_enums", "internal_enums", "sems"],
  "properties": {
    "version": {"type": "string"},
    "tokens": {"type": "object", "required": ["color", "alias", "contrast_rules", "type", "family", "space", "motion", "graph", "z", "zone"]},
    "signified_enums": {"type": "array", "items": {"type": "string"}},
    "labelled_enums": {"type": "array", "items": {"type": "string"}},
    "internal_enums": {"type": "array", "items": {"type": "string"}},
    "sems": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "name", "channels", "binds", "views", "primitive", "term", "exclusion"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEM-0[0-9]{2}$"},
        "name": {"type": "string"},
        "channels": {"type": "object", "required": ["shape", "color"]},
        "binds": {"type": "array"},
        "views": {"type": "array", "items": {"type": "integer"}},
        "primitive": {"type": "string"},
        "term": {"type": "string"},
        "exclusion": {"type": "string"}
      }
    }}
  }
}
