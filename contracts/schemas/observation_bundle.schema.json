                "eq": "#/$defs/Eq",
                "implies": "#/$defs/Implies",
                "in": "#/$defs/In",
                "not": "#/$defs/Not",
                "or": "#/$defs/Or",
                "transition_in": "#/$defs/TransitionIn"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/In"
              },
              {
                "$ref": "#/$defs/Not"
              },
              {
                "$ref": "#/$defs/And"
              },
              {
                "$ref": "#/$defs/Or"
