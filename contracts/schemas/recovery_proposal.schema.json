{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art:[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "cira.recovery_proposal/1.0.2",
  "additionalProperties": false,
  "properties": {
    "description_from_engine": {
      "title": "Description From Engine",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9_.:/\\-]{0,190}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "reconstruction_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "status": {
      "const": "PROPOSED",
      "title": "Status",
      "type": "string"
    },
    "subject_refs": {
      "items": {
        "pattern": "^[a-z]+:[a-z0-9][a-z0-9_.:/\\-]{0,190}$",
        "type": "string"
      },
      "title": "Subject Refs",
      "type": "array"
    }
  },
  "required": [
    "proposal_id",
    "reconstruction_ref",
    "subject_refs",
    "description_from_engine",
    "status"
  ],
  "title": "RecoveryProposal",
  "type": "object"
}
