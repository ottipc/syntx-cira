{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art:[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvalReason": {
      "enum": [
        "OK",
        "UNKNOWN_INPUT",
        "UNDETERMINED_INPUT",
        "NOT_APPLICABLE_INPUT",
        "REQUIREMENT_NOT_MET"
      ],
      "title": "EvalReason",
      "type": "string"
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "properties": {
        "input_attribute_refs": {
          "default": [],
          "items": {
            "pattern": "^[a-z]+:[a-z0-9][a-z0-9_.:/\\-]{0,190}$",
            "type": "string"
          },
          "title": "Input Attribute Refs",
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/EvalReason"
        },
        "result": {
          "$ref": "#/$defs/RuleResult"
        },
        "rule_ref": {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9_.:/\\-]{0,190}$",
          "title": "Rule Ref",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Rule Version",
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/StateSpace"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "tick_to": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick To"
        }
      },
      "required": [
        "rule_ref",
        "rule_version",
        "space",
        "tick",
        "result",
        "reason"
      ],
      "title": "RuleEvaluation",
      "type": "object"
    },
    "RuleResult": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNEVALUABLE"
      ],
      "title": "RuleResult",
      "type": "string"
    },
    "RuleSummary": {
      "additionalProperties": false,
      "properties": {
        "false": {
          "title": "False",
          "type": "integer"
        },
        "not_in_validity": {
          "title": "Not In Validity",
          "type": "integer"
        },
        "true": {
          "title": "True",
          "type": "integer"
        },
        "unevaluable": {
          "title": "Unevaluable",
          "type": "integer"
        }
      },
      "required": [
        "true",
        "false",
        "unevaluable",
        "not_in_validity"
      ],
      "title": "RuleSummary",
      "type": "object"
    },
    "StateSpace": {
      "enum": [
        "A",
        "O",
        "R"
      ],
      "title": "StateSpace",
      "type": "string"
    }
  },
  "$id": "cira.rule_evaluation_set/1.0.2",
  "additionalProperties": false,
  "properties": {
    "evaluations": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "governance_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "not_in_validity": {
      "title": "Not In Validity",
      "type": "integer"
    },
    "space": {
      "$ref": "#/$defs/StateSpace"
    },
    "summary": {
      "$ref": "#/$defs/RuleSummary"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    }
  },
  "required": [
    "governance_ref",
    "space",
    "tick",
    "evaluations",
    "not_in_validity",
    "summary"
  ],
  "title": "RuleEvaluationSet",
  "type": "object"
}
