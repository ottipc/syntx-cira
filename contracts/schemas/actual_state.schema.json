{
  "$defs": {
    "ActualValue": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "attribute_ref": {
          "pattern": "^[a-z]+:[a-z0-9][a-z0-9_.:/\\-]{0,190}$",
          "title": "Attribute Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "attribute_ref",
        "applicability"
      ],
      "title": "ActualValue",
      "type": "object"
    },
    "Applicability": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art:[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "cira.actual_state/1.0.2",
  "additionalProperties": false,
  "properties": {
    "last_seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seq"
    },
    "scenario_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/ActualValue"
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "scenario_ref",
    "tick",
    "values"
  ],
  "title": "ActualState",
  "type": "object"
}
